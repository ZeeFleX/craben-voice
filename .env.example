# Скопируй в .env и заполни под свой coturn.

# Адрес TURN-сервера. Можно несколько через запятую.
# turn:  — UDP/TCP, turns: — TLS (порт 5349)
TURN_URL=turn:turn.example.com:3478

# Вариант 1 (рекомендуется): общий секрет из turnserver.conf (static-auth-secret).
# Сервер будет выдавать браузерам временные креды на сутки, секрет наружу не попадает.
TURN_SECRET=

# Вариант 2: постоянные логин/пароль (user=... в turnserver.conf).
# Видны всем, кто открыл страницу — используй только для закрытого круга.
TURN_USER=
TURN_PASS=
